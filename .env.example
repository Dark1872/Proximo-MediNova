PORT=3001
NODE_ENV=development

# PostgreSQL (Neon) — valores reales SOLO en .env local o en el panel de Render, nunca en Git.
PGHOST=your-neon-host.neon.tech
PGDATABASE=neondb
PGUSER=your_db_user
PGPASSWORD=your_password_here
PGSSLMODE=require

# Seguridad (OBLIGATORIO en Backend y Gateway; sin ellos los servicios no arrancan)
# - JWT_SECRET: mismo valor en Backend y Gateway, mínimo 32 bytes.
# - INTERNAL_API_SECRET: mismo valor en Backend y Gateway, mínimo 32 bytes, distinto de JWT_SECRET.
# Generar cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
INTERNAL_API_SECRET=

# Frontend API Configuration
VITE_API_URL=http://localhost:4000
#VITE_API_URL=https://farmalink-gateway.onrender.com
