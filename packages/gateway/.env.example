PORT=4000
# URL del Backend. Acepta URL completa o host:puerto sin esquema (dirección interna de Render,
# panel del Backend > Connect > Internal), p. ej. farmalink-backend-xxxx:10000
BACKEND_URL=http://localhost:3001
AI_PROXY_TIMEOUT_MS=15000
# Alternativa pública opcional (solo si BACKEND_URL privada no responde al arrancar)
BACKEND_PUBLIC_URL=
# Resiliencia (opcionales): plazo total, límite por intento, esperas entre reintentos GET
GATEWAY_BACKEND_TIMEOUT_MS=45000
GATEWAY_BACKEND_ATTEMPT_TIMEOUT_MS=20000
GATEWAY_RETRY_DELAYS_MS=1000,3000,6000
GATEWAY_DEEP_HEALTH_TIMEOUT_MS=15000

# Seguridad (OBLIGATORIO; sin ellos el Gateway no arranca)
# Deben ser EXACTAMENTE los mismos valores configurados en el Backend.
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
INTERNAL_API_SECRET=
