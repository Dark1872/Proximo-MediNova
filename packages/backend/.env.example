PORT=3001
NODE_ENV=development

# PostgreSQL (Neon) — use DATABASE_URL o las variables PG*. Valores reales nunca en Git.
# DATABASE_URL=
PGHOST=your-neon-host.neon.tech
PGDATABASE=neondb
PGUSER=your_db_user
PGPASSWORD=your_password_here
PGSSLMODE=require
PGPORT=5432

# Seguridad (OBLIGATORIO; sin ellos el Backend no arranca)
# JWT_SECRET: idéntico al del Gateway, mínimo 32 bytes.
# INTERNAL_API_SECRET: idéntico al del Gateway, mínimo 32 bytes, distinto de JWT_SECRET.
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
INTERNAL_API_SECRET=

# Asistente IA
ENABLE_AI_ASSISTANT=false
AI_USE_GEMINI=false
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=12000
GEMINI_API_KEY=
